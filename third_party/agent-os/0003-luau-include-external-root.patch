--- a/memcontainers/programs/luau/glue/BUILD.bazel
+++ b/memcontainers/programs/luau/glue/BUILD.bazel
@@ -105,7 +105,11 @@
         # Force Luau's public C API to extern "C" so the Zig entry's C-mode @cImport links it (else
         # the API is C++-mangled, resolves to `env` imports, and the VM is dead-stripped).
+        # Nested module (@agent-os+) and monorepo: make -include basenames resolve. Without these
+        # -I flags, zig c++ reports CacheCheckFailed on every Luau .cpp under bzlmod.
+        "-Iexternal/agent-os+/memcontainers/programs/luau/glue",
+        "-Imemcontainers/programs/luau/glue",
         "-include",
-        "memcontainers/programs/luau/glue/force_extern_c.h",
+        "force_extern_c.h",
         "-fno-exceptions",
         "-fno-rtti",
     ],
@@ -185,7 +189,11 @@
     copts = [
         # Force-include the analysis EH shim into every TU (mc_analysis_abort + try/catch neutralize).
+        "-Iexternal/agent-os+/memcontainers/programs/luau/glue",
+        "-Imemcontainers/programs/luau/glue",
         "-include",
-        "memcontainers/programs/luau/glue/analysis_eh_shim.h",
+        "analysis_eh_shim.h",
         "-fno-exceptions",
         "-fno-rtti",
     ],
