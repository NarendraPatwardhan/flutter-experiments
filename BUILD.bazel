load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_library", "flutter_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# AgentOS — git-pinned module (built from @agent-os, not release zips / not JS)
# ---------------------------------------------------------------------------
filegroup(
    name = "agentos_kernel",
    srcs = ["@agent-os//memcontainers/kernel/rust:kernel"],
)

# Guest image: loom (posix + Luau) — public @agent-os image tar.
filegroup(
    name = "agentos_loom",
    srcs = ["@agent-os//memcontainers/images:loom"],
)

# Product C ABI over KernelHost + kernel wasm for staging next to the Linux app.
alias(
    name = "agentos_flutter_host",
    actual = "//native/agentos_flutter_host:agentos_flutter_host",
)

# Stage kernel + loom image + opt+stripped host .so.
genrule(
    name = "agentos_native_bundle",
    srcs = [
        ":agentos_kernel",
        ":agentos_loom",
        ":agentos_flutter_host",
    ],
    outs = [
        "agentos_native/kernel.wasm",
        "agentos_native/loom.tar",
        "agentos_native/libagentos_flutter_host.so",
    ],
    cmd = """
set -euo pipefail
cp $(location :agentos_kernel) $(location agentos_native/kernel.wasm)
cp $(location :agentos_loom) $(location agentos_native/loom.tar)
cp $(location :agentos_flutter_host) $(location agentos_native/libagentos_flutter_host.so)
""",
)

# Complete Linux product: Flutter app.linux bundle + AgentOS native host assets.
# Unpack and run from the tree root (binary next to data/ and lib/).
genrule(
    name = "linux_product_bundle",
    srcs = [
        ":app.linux",
        ":agentos_native_bundle",
    ],
    outs = ["linux_product.tar.gz"],
    cmd = """
set -euo pipefail
WORKDIR=$$(mktemp -d)
trap 'rm -rf "$$WORKDIR"' EXIT
# Locate the Flutter Linux release tree among //:app.linux outputs.
ART=""
for f in $(locations :app.linux); do
  if [ -d "$$f" ] && [ -e "$$f/flutter_bazel_hello" ]; then
    ART="$$f"
    break
  fi
done
if [ -z "$$ART" ]; then
  echo "linux_product_bundle: could not find app.linux_build_artifacts tree" >&2
  ls -la $(locations :app.linux) >&2 || true
  exit 1
fi
cp -a "$$ART/." "$$WORKDIR/"
mkdir -p "$$WORKDIR/lib" "$$WORKDIR/data"
for f in $(locations :agentos_native_bundle); do
  case "$$f" in
    *libagentos_flutter_host.so) cp -f "$$f" "$$WORKDIR/lib/" ;;
    *kernel.wasm) cp -f "$$f" "$$WORKDIR/data/" ;;
    *loom.tar) cp -f "$$f" "$$WORKDIR/data/" ;;
  esac
done
test -f "$$WORKDIR/lib/libagentos_flutter_host.so"
test -f "$$WORKDIR/data/kernel.wasm"
test -f "$$WORKDIR/data/loom.tar"
tar -C "$$WORKDIR" -czf $(location linux_product.tar.gz) .
""",
)

flutter_library(
    name = "lib",
    srcs = glob(["lib/**"]),
    pubspec = "pubspec.yaml",
    deps = [
        "@flutter_sdk//flutter/packages/flutter",
        "@flutter_sdk//flutter/packages/flutter_test",
    ],
)

flutter_test(
    name = "widget_test",
    srcs = glob(["test/**"]),
    embed = [":lib"],
)

filegroup(
    name = "linux_files",
    srcs = glob(
        ["linux/**"],
        exclude = [
            "linux/flutter/ephemeral/**",
            "linux/**/CMakeFiles/**",
            "linux/**/build/**",
        ],
    ),
)

# Primary product: Linux desktop binary/bundle.
flutter_app(
    name = "app",
    embed = [":lib"],
    linux = {
        "srcs": [":linux_files"],
        "mode": "release",
    },
)
