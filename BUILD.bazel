load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_library", "flutter_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# AgentOS — git-pinned module smoke (built from @agent-os, not release zips)
# ---------------------------------------------------------------------------
filegroup(
    name = "agentos_kernel",
    srcs = ["@agent-os//memcontainers/kernel/rust:kernel"],
)

flutter_library(
    name = "lib",
    srcs = glob(["lib/**"]),
    pubspec = "pubspec.yaml",
    deps = [
        "@flutter_sdk//flutter/packages/flutter",
        "@flutter_sdk//flutter/packages/flutter_test",
    ],
)

flutter_test(
    name = "widget_test",
    srcs = glob(["test/**"]),
    embed = [":lib"],
)

filegroup(
    name = "linux_files",
    srcs = glob(
        ["linux/**"],
        exclude = [
            "linux/flutter/ephemeral/**",
            "linux/**/CMakeFiles/**",
            "linux/**/build/**",
        ],
    ),
)

# Primary product: Linux desktop binary/bundle.
flutter_app(
    name = "app",
    embed = [":lib"],
    linux = {
        "srcs": [":linux_files"],
        "mode": "release",
    },
)
