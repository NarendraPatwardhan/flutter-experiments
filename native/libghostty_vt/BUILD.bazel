# libghostty-vt via rules_zig (product Zig 0.16.0 only).
# Declared Zig modules + codegen — not shell `zig build` of Ghostty's build.zig.

load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library", "zig_shared_library")

package(default_visibility = ["//visibility:public"])

# --- Option packages ----------------------------------------------------------

zig_library(
    name = "build_options",
    main = "options/build_options.zig",
    import_name = "build_options",
)

zig_library(
    name = "terminal_options",
    main = "options/terminal_options.zig",
    import_name = "terminal_options",
)

# --- uucode: generate tables, stage one src tree, compile as one module -------

UUCODE_GENERATE_SRCS = [
    "@uucode//:src/ascii.zig",
    "@uucode//:src/build_config.zig",
    "@uucode//:src/code_point.zig",
    "@uucode//:src/components.zig",
    "@uucode//:src/config.zig",
    "@uucode//:src/fields.zig",
    "@uucode//:src/generate.zig",
    "@uucode//:src/get.zig",
    "@uucode//:src/grapheme.zig",
    "@uucode//:src/multi_slice.zig",
    "@uucode//:src/quirks.zig",
    "@uucode//:src/root.zig",
    "@uucode//:src/storage.zig",
    "@uucode//:src/types.zig",
    "@uucode//:src/utf8.zig",
]

# Files that belong in the runtime uucode module (no generate.zig).
UUCODE_LIB_BASENAMES = [
    "ascii.zig",
    "build_config.zig",
    "code_point.zig",
    "components.zig",
    "config.zig",
    "fields.zig",
    "get.zig",
    "grapheme.zig",
    "multi_slice.zig",
    "quirks.zig",
    "root.zig",
    "storage.zig",
    "types.zig",
    "utf8.zig",
]

zig_binary(
    name = "uucode_generate",
    main = "@uucode//:src/generate.zig",
    srcs = UUCODE_GENERATE_SRCS,
    extra_srcs = ["@uucode//:ucd"],
)

# Produce tables.zig then stage a full src/ tree so @import("tables.zig") resolves
# next to get.zig (rules_zig relative imports use the on-disk path of the importer).
genrule(
    name = "uucode_staged_src",
    srcs = ["@uucode//:tree"],
    tools = [":uucode_generate"],
    outs = ["uucode_staged/src/%s" % f for f in UUCODE_LIB_BASENAMES] + [
        "uucode_staged/src/tables.zig",
    ],
    cmd = """
set -euo pipefail
ROOT=""
for f in $(locations @uucode//:tree); do
  case "$$f" in
    */src/root.zig)
      ROOT=$$(cd "$$(dirname "$$f")/.." && pwd)
      break
      ;;
  esac
done
if [ -z "$$ROOT" ] || [ ! -d "$$ROOT/ucd" ]; then
  echo "uucode root/ucd not found" >&2
  exit 1
fi
STAGED=$$(mktemp -d)
mkdir -p "$$STAGED/src"
# Copy lib sources into stage (no generate.zig).
for f in ascii.zig build_config.zig code_point.zig components.zig config.zig \\
         fields.zig get.zig grapheme.zig multi_slice.zig quirks.zig root.zig \\
         storage.zig types.zig utf8.zig; do
  cp -f "$$ROOT/src/$$f" "$$STAGED/src/$$f"
done
GEN=$(location :uucode_generate)
GEN_ABS=$$(cd $$(dirname "$$GEN") && pwd)/$$(basename "$$GEN")
cd "$$ROOT"
"$$GEN_ABS" "$$STAGED/src/tables.zig"
# Emit declared outs (genrule does not pre-create nested out dirs).
OUTDIR=$$(dirname $(location uucode_staged/src/root.zig))
mkdir -p "$$OUTDIR"
cp -a "$$STAGED/src/." "$$OUTDIR/"
""",
)

UUCODE_STAGED_SRCS = [
    "uucode_staged/src/%s" % f for f in UUCODE_LIB_BASENAMES
] + [
    "uucode_staged/src/tables.zig",
]

zig_library(
    name = "uucode",
    main = "uucode_staged/src/root.zig",
    srcs = UUCODE_STAGED_SRCS,
    import_name = "uucode",
)

# --- Ghostty unicode table generators ----------------------------------------

UNICODE_ZIG = [
    "@ghostty//:src/unicode/lut.zig",
    "@ghostty//:src/unicode/props.zig",
    "@ghostty//:src/unicode/props_table.zig",
    "@ghostty//:src/unicode/props_uucode.zig",
    "@ghostty//:src/unicode/symbols_table.zig",
    "@ghostty//:src/unicode/symbols_uucode.zig",
    "@ghostty//:src/unicode/grapheme.zig",
    "@ghostty//:src/unicode/main.zig",
]

zig_library(
    name = "unicode_tables_stub",
    main = "stubs/unicode_tables_stub.zig",
    import_name = "unicode_tables",
)

zig_library(
    name = "symbols_tables_stub",
    main = "stubs/symbols_tables_stub.zig",
    import_name = "symbols_tables",
)

zig_binary(
    name = "props_unigen",
    main = "@ghostty//:src/unicode/props_uucode.zig",
    srcs = UNICODE_ZIG,
    deps = [
        ":uucode",
        ":unicode_tables_stub",
        ":symbols_tables_stub",
    ],
)

zig_binary(
    name = "symbols_unigen",
    main = "@ghostty//:src/unicode/symbols_uucode.zig",
    srcs = UNICODE_ZIG,
    deps = [
        ":uucode",
        ":unicode_tables_stub",
        ":symbols_tables_stub",
    ],
)

genrule(
    name = "gen_ghostty_unicode_tables",
    tools = [
        ":props_unigen",
        ":symbols_unigen",
    ],
    outs = [
        "gen/unicode_tables.zig",
        "gen/symbols_tables.zig",
    ],
    cmd = """
set -euo pipefail
$(location :props_unigen) > $(location gen/unicode_tables.zig)
$(location :symbols_unigen) > $(location gen/symbols_tables.zig)
""",
)

zig_library(
    name = "unicode_tables",
    main = ":gen/unicode_tables.zig",
    import_name = "unicode_tables",
)

zig_library(
    name = "symbols_tables",
    main = ":gen/symbols_tables.zig",
    import_name = "symbols_tables",
)

# --- libghostty-vt shared library --------------------------------------------

zig_shared_library(
    name = "libghostty_vt",
    main = "@ghostty//:src/lib_vt.zig",
    srcs = ["@ghostty//:zig_srcs"],
    extra_srcs = ["@ghostty//:headers"],
    deps = [
        ":build_options",
        ":terminal_options",
        ":uucode",
        ":unicode_tables",
        ":symbols_tables",
    ],
    shared_lib_name = "libghostty-vt.so",
)
