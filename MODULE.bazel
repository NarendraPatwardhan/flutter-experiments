"""flutter-app — Linux Flutter host with AgentOS as a git-pinned Bazel module.

AgentOS is a git-pinned Bazel module. Runtime artifacts (for example kernel)
come from @agent-os//… labels built from that pin — not from prebuilt release
downloads and not from a local_path_override.

This product is a native host only. Do not use the AgentOS JavaScript/browser
host path (sdk-js / mc-core.mjs).

bzlmod only applies overrides from the root module. AgentOS assumes it is root
for some extensions (elixir, hermetic_cc @zig_sdk). This MODULE re-hosts
hermetic_cc at root and patches AgentOS to drop the Elixir/server block (not
needed for guest wasm / host integration).
"""

module(
    name = "flutter_bazel_hello",
    version = "0.0.1",
)

# ---------------------------------------------------------------------------
# AgentOS — git-pinned external module
#
# License: Business Source License 1.1 (BSL 1.1), licensor opyt.cloud.
# This product is Apache-2.0; AgentOS itself is not. Fetching and linking
# @agent-os is subject to upstream BSL terms (see that repo's LICENSE).
# Change license on the Change Date is Apache-2.0 per upstream parameters.
# ---------------------------------------------------------------------------
bazel_dep(name = "agent-os", version = "0.0.0")

git_override(
    module_name = "agent-os",
    commit = "1b5bbc116c60d98b01c80e96d65caf3d628c1fcb",
    patch_strip = 1,
    patches = [
        "//third_party/agent-os:0001-module-strip-elixir-server.patch",
        "//third_party/agent-os:0002-tree-sitter-load-agent-os.patch",
        # Luau glue copts used main-repo-relative -include paths; under @agent-os those
        # resolve as missing headers and surface as zig CacheCheckFailed on every .cpp.
        "//third_party/agent-os:0003-luau-include-external-root.patch",
        # Zig/wasi default 16MiB stack → Wasm initial memory; match Rust guests (1MiB)
        # until agent-os upstream ships the same linkopt.
        "//third_party/agent-os:0004-sqlite-1mib-stack.patch",
    ],
    remote = "https://github.com/NarendraPatwardhan/agent-os.git",
)

# hermetic_cc only materializes @zig_sdk when the **root** module uses the extension
# (see hermetic_cc_toolchain toolchain/ext.bzl). AgentOS imports zig_sdk for
# git-engine host C (zig cc). That is hermetic_cc's C toolchain, not product Zig.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

hermetic_cc = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(hermetic_cc, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

# ---------------------------------------------------------------------------
# Product Zig — single version 0.16.0 via rules_zig (libghostty-vt, etc.)
# Do not add another product Zig version.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_zig", version = "0.16.0")

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.index(file = "//:zig_index.json")
zig.toolchain(zig_version = "0.16.0")
use_repo(zig, "zig_toolchains")

register_toolchains("@rules_zig//zig/target:all")
register_toolchains("@zig_toolchains//:all")

# Ghostty source pin (minimum_zig_version 0.16.0). Built with rules_zig targets,
# not shell genrule wrapping `zig build`.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ghostty",
    build_file = "//third_party/ghostty:ghostty.BUILD",
    sha256 = "f5002725736fdae2ad56d61137de4c87eca32355c0e17840a7fec9ccee6073d1",
    strip_prefix = "ghostty-9e30f70f23418fecbdca1088673000417527c4e4",
    urls = [
        "https://github.com/ghostty-org/ghostty/archive/9e30f70f23418fecbdca1088673000417527c4e4.tar.gz",
    ],
)

# uucode — Ghostty lib-vt Unicode dependency (same pin as Ghostty build.zig.zon).
http_archive(
    name = "uucode",
    build_file = "//third_party/uucode:uucode.BUILD",
    patch_strip = 1,
    patches = [
        # Single-module imports (Zig 0.16) + Ghostty build_config as src/build_config.zig.
        "//third_party/uucode:0001-single-module-imports.patch",
    ],
    sha256 = "7e76fc7fab1e7ac728c52b35bbb3e5b8c639841abfc7fe1a4bcb13050594bc9e",
    strip_prefix = "uucode-2826a37a4562284fdacd8fa029d49509cc9bffcd",
    urls = [
        "https://deps.files.ghostty.org/uucode-2826a37a4562284fdacd8fa029d49509cc9bffcd.tar.gz",
    ],
)

# Rust host cdylib (product C ABI over @agent-os wasmtime host)
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
    ],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# ---------------------------------------------------------------------------
# Flutter (rules_flutter) — primary Linux host product
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_flutter", version = "0.2.1")

git_override(
    module_name = "rules_flutter",
    remote = "https://github.com/SpencerC/rules_flutter.git",
    commit = "dee82b2136b0b7ea56ac7735bf7c311e6458faa0",  # v0.2.1
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(
    # 3.24.0 matches rules_flutter hello_world offline package_graph.
    flutter_version = "3.24.0",
    precache = ["linux"],
)
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
