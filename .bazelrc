# ---------------------------------------------------------------------------
# Zero local analysis on the AGENT HOST:
#   git push && bb remote --run_from_branch=main --os=linux --script '…'
#
# On the BuildBuddy remote runner (coordinator), Bazel must be able to run
# rules_flutter SetupFlutterWorkspace as a *runner-local* action. Pure
# spawn_strategy=remote alone breaks that mnemonic. Runner-local ≠ agent-local.
#
# AgentOS is a git_override pin; nested C/Zig needs sandbox mounts below.
# Auth: bb login. Never put API keys here.
# ---------------------------------------------------------------------------
common --enable_bzlmod
common --enable_workspace=false
common --enable_runfiles
common --enable_platform_specific_config
common --incompatible_strict_action_env
common --incompatible_disallow_empty_glob=false
common --registry=https://bcr.bazel.build/

# Hermetic Java for analysis (on the remote runner under bb remote).
common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# Nested @agent-os C/C++/Zig (Zig caches under /tmp or home)
build --sandbox_add_mount_pair=/tmp
build --sandbox_add_mount_pair=/home
common --copt=-w
common --host_copt=-w
# ZigBuildExe: keep on the BB runner FS (not RBE workers). Shared remote /tmp zig
# caches produce CacheCheckFailed under high parallelism.
build --modify_execution_info=ZigBuildExe=+no-remote,ZigBuildLib=+no-remote,ZigBuildTest=+no-remote
# Fresh zig cache dir per Bazel server start; avoids poisoned entries from bad -include runs.
build --action_env=ZIG_GLOBAL_CACHE_DIR=/tmp/zig-cache-agentos-flutter
build --action_env=ZIG_LOCAL_CACHE_DIR=/tmp/zig-cache-agentos-flutter
# rules_zig shared cache (product Zig 0.16.0)
build --repo_env=RULES_ZIG_CACHE_PREFIX_LINUX=/tmp/zig-cache
build --repo_env=RULES_ZIG_CACHE_PREFIX=/tmp/zig-cache

build --verbose_failures

# BuildBuddy BES + cache + executor (available to the remote runner).
common --bes_results_url=https://app.buildbuddy.io/invocation/
common --bes_backend=grpcs://remote.buildbuddy.io
common --remote_cache=grpcs://remote.buildbuddy.io
common --remote_executor=grpcs://remote.buildbuddy.io

common --remote_default_exec_properties=container-image=docker://gcr.io/flame-public/rbe-ubuntu20-04@sha256:036ae8c90876fa22da9ace6f8218e614f4cd500a154fc162973fff691e72d28e
common --remote_default_exec_properties=EstimatedCPU=4
common --remote_default_exec_properties=EstimatedMemory=8GB
common --remote_default_exec_properties=EstimatedFreeDiskBytes=20GB
common --remote_default_exec_properties=default-timeout=30m

# Prefer remote for remoting-friendly actions; allow runner-local for
# SetupFlutterWorkspace and similar (must run next to the coordinator FS).
common --spawn_strategy=remote,sandboxed,local
common --strategy=remote,sandboxed,local
common --genrule_strategy=remote,sandboxed,local
common --remote_local_fallback=true

common --jobs=100
common --remote_timeout=3600
common --remote_retries=5
# Pull top-level outputs back to the agent so `bb remote` can stage them for local run.
# (minimal caused CAS download failures after a successful remote build.)
common --remote_download_toplevel
common --remote_cache_compression
common --remote_cache_async

common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
